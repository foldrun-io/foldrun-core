{
  "name": "@foldrun/core",
  "version": "2.12.0",
  "description": "Agents are just folders. The format, the runner, the checks.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "foldrun": {
    "publicApi": [
      ".",
      "./agents-md",
      "./browser-pod",
      "./flow-patterns",
      "./history",
      "./hooks",
      "./kinds",
      "./layout",
      "./limits",
      "./network",
      "./providers",
      "./subagents",
      "./tool-names",
      "./scan"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "index.ts",
    "templates",
    "README.md",
    "LICENSING.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepare": "npm run build && (test ! -f .githooks/install.sh || sh .githooks/install.sh)",
    "prepublishOnly": "npm run build",
    "test": "FOLDRUN_DATA=$(mktemp -d /tmp/foldrun-test-XXXXXX) node --test *.test.ts $(ls tests/*.test.ts | grep -v e2e)",
    "container": "FOLDRUN_CONTAINER_E2E=1 node scripts/ts-test.mjs tests/container-e2e.test.ts --test-timeout=600000",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "gray-matter": "^4.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foldrun-io/foldrun-core.git"
  },
  "homepage": "https://foldrun.io",
  "keywords": [
    "agents",
    "llm",
    "markdown",
    "workflows",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  }
}
